{% set hw_keys = keys | rejectattr('pin', 'none') | rejectattr('gpio', 'none') | list %}
static inline void _init_keys()
{
{% for key_gpio, pins in key_gpios | dictsort %}
  {% if key_gpio %}
    gd32_gpio_enable_clock({{ key_gpio }});
  {% endif %}
{% endfor %}
{% for key in hw_keys %}
  gpio_mode_set((uint32_t){{ key.gpio }}, GPIO_MODE_INPUT, {{ 'GPIO_PUPD_PULLUP' if key.active_low else 'GPIO_PUPD_PULLDOWN' }}, {{ key.pin }});
{% endfor %}
}

static inline uint32_t _read_keys()
{
  uint32_t keys = 0;
{% for key in hw_keys %}
  if ({{'!' if key.active_low }}gpio_input_bit_get((uint32_t){{ key.gpio }}, {{ key.pin }}))
    keys |= (1 << {{ key.key }});
{% endfor %}
  return keys;
}

{% set hw_trims = trims | selectattr('dec', 'defined') | selectattr('inc', 'defined') | list %}
static inline void _init_trims()
{
{% for trim_gpio, pins in trim_gpios | dictsort %}
  gd32_gpio_enable_clock({{ trim_gpio }});
{% endfor %}
{% for trim in hw_trims %}
  gpio_mode_set((uint32_t){{ trim.dec.gpio }}, GPIO_MODE_INPUT, {{ 'GPIO_PUPD_PULLUP' if trim.dec.active_low else 'GPIO_PUPD_PULLDOWN' }}, {{ trim.dec.pin }});
  gpio_mode_set((uint32_t){{ trim.inc.gpio }}, GPIO_MODE_INPUT, {{ 'GPIO_PUPD_PULLUP' if trim.inc.active_low else 'GPIO_PUPD_PULLDOWN' }}, {{ trim.inc.pin }});
{% endfor %}
}

static inline uint32_t _read_trims()
{
  uint32_t trims = 0;
{% for trim in hw_trims %}
  if ({{'!' if trim.dec.active_low }}gpio_input_bit_get((uint32_t){{ trim.dec.gpio }}, {{ trim.dec.pin }}))
    trims |= (1 << {{ loop.index0 * 2 }});
  if ({{'!' if trim.inc.active_low }}gpio_input_bit_get((uint32_t){{ trim.inc.gpio }}, {{ trim.inc.pin }}))
    trims |= (1 << {{ loop.index0 * 2 + 1 }});
{% endfor %}
  return trims;
}
